# Dotfiles and dot-directories
.*
!.gitignore
!.dockerignore
!.env.example
!.github/
!.mvn/

# Java and Maven outputs
target/
*.class
*.jar
*.log
.mvn/timing.properties

# Local IDE and operating-system files
*.iml
Thumbs.db
*.tmp
*.swp

# Local environment and generated credentials
secrets/
*.pem
*.key
*.p12
*.jks

# Local runtime data
data/
logs/
