# Copy this file to .env and replace every change-me value before local startup.
POSTGRES_ADMIN_PASSWORD=change-me-admin
USER_DB_PASSWORD=change-me-user
POST_DB_PASSWORD=change-me-post
FOLLOW_DB_PASSWORD=change-me-follow
TIMELINE_DB_PASSWORD=change-me-timeline
NOTIFICATION_DB_PASSWORD=change-me-notification

# Generate jwt-private.pem and jwt-public.pem in this ignored local directory.
JWT_KEYS_DIRECTORY=./secrets
# Set this to `id -g`; User Service remains non-root and receives only this supplemental group.
JWT_KEYS_GID=change-me-numeric-group-id
