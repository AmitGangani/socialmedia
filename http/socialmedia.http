### Poll Bob's notifications for Alice's follow and reply
# Repeat for at most 10 seconds after the triggering action. The page is owned by Bob's JWT
# subject; no target user identifier is accepted by the notification contract.
# @name bobNotifications
GET {{gateway}}/api/v1/notifications?size=20
Authorization: Bearer {{bobJwt}}
X-Correlation-Id: scenario4-poll-bob-notifications

> {%
client.global.set("notificationCursor", response.body.nextCursor);
%}

### Continue Bob's stable notification keyset
GET {{gateway}}/api/v1/notifications?size=20&cursor={{notificationCursor}}
Authorization: Bearer {{bobJwt}}
X-Correlation-Id: scenario4-bob-notifications-next

### Alice retrieves only Alice-owned notifications
GET {{gateway}}/api/v1/notifications?size=20
Authorization: Bearer {{aliceJwt}}
X-Correlation-Id: scenario6-alice-notifications

### A client-supplied target cannot expose Bob's notifications to Alice
# The extra query/header are not contract inputs. The response remains Alice's JWT-subject page
# and never contains Bob-owned rows.
GET {{gateway}}/api/v1/notifications?size=20&userId={{bobId}}
Authorization: Bearer {{aliceJwt}}
X-Target-User-Id: {{bobId}}
X-Correlation-Id: scenario6-reject-cross-user-notifications

### Reject a malformed Notification cursor
GET {{gateway}}/api/v1/notifications?cursor=not-a-cursor
Authorization: Bearer {{bobJwt}}
