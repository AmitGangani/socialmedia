### Bob replies to Bob's own visible post without notifying himself
# Run before deleting originalPostId. The reply succeeds normally, but its event is recorded as
# processed without a visible notification because actor and recipient are the same.
# @name createSelfReply
POST {{gateway}}/api/v1/posts/{{originalPostId}}/replies
Authorization: Bearer {{bobJwt}}
Content-Type: application/json
X-Correlation-Id: scenario4-self-reply-no-notification

{
  "text": "A valid self-reply that must not notify Bob"
}

> {%
client.global.set("selfReplyPostId", response.body.id);
%}

### Notification DLT inspection and unchanged-event replay (manual commands)
# 1. Publish a deliberately unknown event type to force the initial attempt plus two one-second
#    retries and consumer-specific DLT publication:
# docker compose exec -T kafka /opt/kafka/bin/kafka-console-producer.sh \
#   --bootstrap-server kafka:9092 --topic post-events.v1 \
#   --property parse.key=true --property key.separator='|' <<'EOF'
# 019f0000-0000-7000-8000-000000000001|{"eventId":"019f0000-0000-7000-8000-000000000002","eventType":"post.unknown.v1","schemaVersion":1,"aggregateId":"019f0000-0000-7000-8000-000000000001","occurredAt":"2026-07-23T00:00:00Z","producer":"post-service","correlationId":"scenario8-notification-dlt","payload":{}}
# EOF
# 2. Inspect the unchanged key/value plus original topic/partition/offset headers. The command
#    exits after one record:
# docker compose exec -T kafka /opt/kafka/bin/kafka-console-consumer.sh \
#   --bootstrap-server kafka:9092 --topic post-events.v1.notification-dlt \
#   --from-beginning --max-messages 1 --property print.key=true --property print.headers=true
# 3. For duplicate-safe replay, copy a real follow.created.v1 or reply-bearing
#    post.published.v1 key/value from its source topic, then republish that exact line twice:
# docker compose exec -T kafka /opt/kafka/bin/kafka-console-producer.sh \
#   --bootstrap-server kafka:9092 --topic <source-topic> \
#   --property parse.key=true --property key.separator='|'
# Do not change eventId, occurredAt, correlationId, payload, or key. The recipient page and
# processed_event/notification uniqueness remain unchanged after both replays.

### Timeline dependency failure (manual command)
# Run `docker compose stop post-service`, execute the request below, then run
# `docker compose start post-service` and repeat after Post is healthy.
GET {{gateway}}/api/v1/timeline/home?size=20
Authorization: Bearer {{aliceJwt}}
X-Correlation-Id: scenario7-post-dependency

### Data runner - create 200 posts for stable Timeline traversal
# Run this named request after Bob is logged in and eligible followers are present. IntelliJ's
# HTTP Client expands the collection into 200 ordinary POST requests. There are no assertions,
# test handlers, direct database writes, or test-framework dependencies.
# @name seedTimelinePosts
< {%
const posts = Array.from({length: 200}, (_, offset) => {
  const sequence = String(offset + 1).padStart(3, "0");
  return {
    text: `Timeline cursor seed ${sequence}`,
    correlationId: `scenario3-seed-post-${sequence}`
  };
});
request.variables.set("timelineSeedPosts", posts);
if (request.iteration() > 0) {
  await sleep(1050);
}
%}
POST {{gateway}}/api/v1/posts
Authorization: Bearer {{bobJwt}}
Content-Type: application/json
X-Correlation-Id: {{$.timelineSeedPosts[*].correlationId}}

{
  "text": "{{$.timelineSeedPosts[*].text}}"
}

### Data runner - register 1,000 follower accounts
# Run the three high-follower requests in order. The first two authentication requests are
# intentionally paced to the Gateway's documented ten-requests-per-minute local auth policy;
# for a faster private-network demonstration, execute the same named requests with `gateway`
# overridden to `http://user-service:8081` from an HTTP Client attached to the Compose network.
# @name registerFanoutFollowers
< {%
const followers = Array.from({length: 1000}, (_, offset) => {
  const sequence = String(offset + 1).padStart(4, "0");
  return {
    email: `fanout-${sequence}@example.test`,
    username: `fanout${sequence}`,
    displayName: `Fanout Follower ${sequence}`,
    correlationId: `scenario9-register-${sequence}`
  };
});
request.variables.set("fanoutFollowers", followers);
if (request.iteration() > 0) {
  await sleep(6100);
}
%}
POST {{gateway}}/api/v1/auth/register
Content-Type: application/json
X-Correlation-Id: {{$.fanoutFollowers[*].correlationId}}

{
  "email": "{{$.fanoutFollowers[*].email}}",
  "username": "{{$.fanoutFollowers[*].username}}",
  "displayName": "{{$.fanoutFollowers[*].displayName}}",
  "bio": "Scenario 9 fan-out data",
  "password": "fanout-demo-password"
}

### Data runner - login 1,000 follower accounts and retain their JWTs
# @name loginFanoutFollowers
< {%
const followers = Array.from({length: 1000}, (_, offset) => {
  const sequence = String(offset + 1).padStart(4, "0");
  return {
    sequence: sequence,
    username: `fanout${sequence}`,
    correlationId: `scenario9-login-${sequence}`
  };
});
request.variables.set("fanoutFollowers", followers);
if (request.iteration() === 0) {
  client.global.set("fanoutFollowerSessions", []);
} else {
  await sleep(6100);
}
%}
POST {{gateway}}/api/v1/auth/login
Content-Type: application/json
X-Correlation-Id: {{$.fanoutFollowers[*].correlationId}}

{
  "login": "{{$.fanoutFollowers[*].username}}",
  "password": "fanout-demo-password"
}

> {%
const sessions = client.global.get("fanoutFollowerSessions") || [];
const follower = request.variables.get("fanoutFollowers")[request.iteration()];
sessions[request.iteration()] = {
  username: follower.username,
  accessToken: response.body.accessToken,
  correlationId: `scenario9-follow-${follower.sequence}`
};
client.global.set("fanoutFollowerSessions", sessions);
%}

### Data runner - make all 1,000 accounts follow Bob
# @name createFanoutFollows
< {%
request.variables.set(
  "fanoutFollowerSessions",
  client.global.get("fanoutFollowerSessions") || []
);
%}
PUT {{gateway}}/api/v1/follows/{{bobId}}
Authorization: Bearer {{$.fanoutFollowerSessions[*].accessToken}}
X-Correlation-Id: {{$.fanoutFollowerSessions[*].correlationId}}

