@gateway = http://localhost:8080
@postService = http://localhost:8082
@aliceEmail = alice@example.test
@aliceUsername = Alice
@alicePassword = correct-horse-battery
@bobEmail = bob@example.test
@bobUsername = Bob
@bobPassword = another-correct-horse

### Register Alice
# @name registerAlice
POST {{gateway}}/api/v1/auth/register
Content-Type: application/json
X-Correlation-Id: scenario1-register-alice

{
  "email": "{{aliceEmail}}",
  "username": "{{aliceUsername}}",
  "displayName": "Alice Example",
  "bio": "Learning service boundaries",
  "password": "{{alicePassword}}"
}

> {%
client.global.set("aliceId", response.body.id);
%}

### Register Bob
# @name registerBob
POST {{gateway}}/api/v1/auth/register
Content-Type: application/json
X-Correlation-Id: scenario1-register-bob

{
  "email": "{{bobEmail}}",
  "username": "{{bobUsername}}",
  "displayName": "Bob Example",
  "bio": "Publishing small posts",
  "password": "{{bobPassword}}"
}

> {%
client.global.set("bobId", response.body.id);
%}

### Login Alice
# @name loginAlice
POST {{gateway}}/api/v1/auth/login
Content-Type: application/json
X-Correlation-Id: scenario1-login-alice

{
  "login": "alice",
  "password": "{{alicePassword}}"
}

> {%
client.global.set("aliceJwt", response.body.accessToken);
%}

### Login Bob by email
# @name loginBob
POST {{gateway}}/api/v1/auth/login
Content-Type: application/json
X-Correlation-Id: scenario1-login-bob

{
  "login": "BOB@EXAMPLE.TEST",
  "password": "{{bobPassword}}"
}

> {%
client.global.set("bobJwt", response.body.accessToken);
%}

### Alice - own account
GET {{gateway}}/api/v1/users/me
Authorization: Bearer {{aliceJwt}}
X-Correlation-Id: scenario1-alice-self

### Bob - public profile
GET {{gateway}}/api/v1/profiles/bOb
X-Correlation-Id: scenario1-bob-profile

### Reject duplicate username ignoring case
POST {{gateway}}/api/v1/auth/register
Content-Type: application/json
X-Correlation-Id: scenario1-duplicate-username

{
  "email": "alice-duplicate@example.test",
  "username": "aLiCe",
  "displayName": "Duplicate Alice",
  "bio": "",
  "password": "{{alicePassword}}"
}

### Reject duplicate email ignoring case
POST {{gateway}}/api/v1/auth/register
Content-Type: application/json
X-Correlation-Id: scenario1-duplicate-email

{
  "email": "ALICE@EXAMPLE.TEST",
  "username": "AliceDuplicate",
  "displayName": "Duplicate Alice",
  "bio": "",
  "password": "{{alicePassword}}"
}

### Reject wrong credentials uniformly
POST {{gateway}}/api/v1/auth/login
Content-Type: application/json
X-Correlation-Id: scenario1-wrong-password

{
  "login": "alice",
  "password": "this-password-is-wrong"
}

### Bob publishes a one-code-point post
# @name publishOneCodePoint
POST {{gateway}}/api/v1/posts
Authorization: Bearer {{bobJwt}}
Content-Type: application/json
X-Correlation-Id: scenario4-publish-one

{
  "text": "A"
}

> {%
client.global.set("boundaryPostId", response.body.id);
%}

### Bob publishes a 280-code-point post
# @name publishMaximumPost
< {%
request.variables.set("maximumPostText", "😀".repeat(280));
%}
POST {{gateway}}/api/v1/posts
Authorization: Bearer {{bobJwt}}
Content-Type: application/json
X-Correlation-Id: scenario4-publish-280

{
  "text": "{{maximumPostText}}"
}

> {%
client.global.set("originalPostId", response.body.id);
%}

### Retrieve Bob's visible post
GET {{gateway}}/api/v1/posts/{{originalPostId}}
X-Correlation-Id: scenario4-get-post

### First Bob profile-post page
# @name firstBobPostPage
GET {{gateway}}/api/v1/users/{{bobId}}/posts?size=1
X-Correlation-Id: scenario4-post-page-1

> {%
client.global.set("postCursor", response.body.nextCursor);
%}

### Next Bob profile-post page
GET {{gateway}}/api/v1/users/{{bobId}}/posts?size=1&cursor={{postCursor}}
X-Correlation-Id: scenario4-post-page-2

### Reject an empty post
POST {{gateway}}/api/v1/posts
Authorization: Bearer {{bobJwt}}
Content-Type: application/json
X-Correlation-Id: scenario6-reject-empty-post

{
  "text": ""
}

### Reject a whitespace-only post
POST {{gateway}}/api/v1/posts
Authorization: Bearer {{bobJwt}}
Content-Type: application/json
X-Correlation-Id: scenario6-reject-blank-post

{
  "text": "   "
}

### Reject a 281-code-point post
< {%
request.variables.set("oversizedPostText", "😀".repeat(281));
%}
POST {{gateway}}/api/v1/posts
Authorization: Bearer {{bobJwt}}
Content-Type: application/json
X-Correlation-Id: scenario6-reject-281

{
  "text": "{{oversizedPostText}}"
}

### Reject client-supplied ownership
POST {{gateway}}/api/v1/posts
Authorization: Bearer {{bobJwt}}
Content-Type: application/json
X-Correlation-Id: scenario6-reject-author-id

{
  "text": "Ownership must come from the JWT",
  "authorId": "{{aliceId}}"
}

### Reject a malformed profile-post cursor
GET {{gateway}}/api/v1/users/{{bobId}}/posts?cursor=not-a-cursor
X-Correlation-Id: scenario6-reject-post-cursor

### Reject an oversized profile-post page
GET {{gateway}}/api/v1/users/{{bobId}}/posts?size=101
X-Correlation-Id: scenario6-reject-post-size

### Reject a protected publish without a JWT
POST {{gateway}}/api/v1/posts
Content-Type: application/json
X-Correlation-Id: scenario6-reject-missing-jwt

{
  "text": "No anonymous publication"
}

### Alice cannot delete Bob's boundary post
DELETE {{gateway}}/api/v1/posts/{{boundaryPostId}}
Authorization: Bearer {{aliceJwt}}
X-Correlation-Id: scenario6-reject-foreign-delete

### The forbidden delete left the post visible
GET {{gateway}}/api/v1/posts/{{boundaryPostId}}
X-Correlation-Id: scenario6-post-still-visible

### Bob deletes his boundary post
DELETE {{gateway}}/api/v1/posts/{{boundaryPostId}}
Authorization: Bearer {{bobJwt}}
X-Correlation-Id: scenario4-owner-delete

### Bob repeats the idempotent delete
DELETE {{gateway}}/api/v1/posts/{{boundaryPostId}}
Authorization: Bearer {{bobJwt}}
X-Correlation-Id: scenario4-owner-delete-repeat

### Deleted post is unavailable directly
GET {{gateway}}/api/v1/posts/{{boundaryPostId}}
X-Correlation-Id: scenario4-get-deleted

### Deleted post is omitted from Bob's profile-post list
GET {{gateway}}/api/v1/users/{{bobId}}/posts?size=20
X-Correlation-Id: scenario4-list-after-delete

### Internal bulk lookup omits the deleted post
# Standalone/private-network validation only; Gateway intentionally does not route /internal/v1.
POST {{postService}}/internal/v1/posts/bulk
Content-Type: application/json
X-Correlation-Id: scenario4-bulk-after-delete

{
  "postIds": ["{{boundaryPostId}}", "{{originalPostId}}"]
}

### No post-edit route exists
PATCH {{gateway}}/api/v1/posts/{{originalPostId}}
Authorization: Bearer {{bobJwt}}
Content-Type: application/json
X-Correlation-Id: scenario4-no-edit-route

{
  "text": "An edit must not be accepted"
}

### Alice follows Bob
# @name followBob
PUT {{gateway}}/api/v1/follows/{{bobId}}
Authorization: Bearer {{aliceJwt}}
X-Correlation-Id: scenario2-follow-bob

> {%
client.global.set("followRelationshipId", response.body.id);
%}

### Repeating Alice follows Bob is idempotent
PUT {{gateway}}/api/v1/follows/{{bobId}}
Authorization: Bearer {{aliceJwt}}
X-Correlation-Id: scenario2-follow-bob-repeat

### Reject Alice following herself
PUT {{gateway}}/api/v1/follows/{{aliceId}}
Authorization: Bearer {{aliceJwt}}
X-Correlation-Id: scenario6-reject-self-follow

### Bob publishes for Alice's home timeline
# @name publishForTimeline
POST {{gateway}}/api/v1/posts
Authorization: Bearer {{bobJwt}}
Content-Type: application/json
X-Correlation-Id: scenario2-publish-fanout

{
  "text": "A post for the home timeline"
}

> {%
client.global.set("timelinePostId", response.body.id);
%}

### Alice home timeline - first page
# @name firstHomePage
GET {{gateway}}/api/v1/timeline/home?size=20
Authorization: Bearer {{aliceJwt}}
X-Correlation-Id: scenario3-home-page-1

> {%
client.global.set("timelineCursor", response.body.nextCursor);
%}

### Alice home timeline - next stable page
GET {{gateway}}/api/v1/timeline/home?size=20&cursor={{timelineCursor}}
Authorization: Bearer {{aliceJwt}}
X-Correlation-Id: scenario3-home-page-2

### Reject malformed Timeline cursor
GET {{gateway}}/api/v1/timeline/home?cursor=not-a-cursor
Authorization: Bearer {{aliceJwt}}
X-Correlation-Id: scenario3-malformed-timeline-cursor

### Reject oversized Timeline page
GET {{gateway}}/api/v1/timeline/home?size=101
Authorization: Bearer {{aliceJwt}}
X-Correlation-Id: scenario3-oversized-timeline-page

### Alice unfollows Bob
DELETE {{gateway}}/api/v1/follows/{{bobId}}
Authorization: Bearer {{aliceJwt}}
X-Correlation-Id: scenario5-unfollow-bob

### Repeating Alice unfollows Bob is idempotent
DELETE {{gateway}}/api/v1/follows/{{bobId}}
Authorization: Bearer {{aliceJwt}}
X-Correlation-Id: scenario5-unfollow-bob-repeat

### Alice re-follows Bob without historical backfill
PUT {{gateway}}/api/v1/follows/{{bobId}}
Authorization: Bearer {{aliceJwt}}
X-Correlation-Id: scenario5-refollow-bob

### Bob publishes after Alice re-follows
POST {{gateway}}/api/v1/posts
Authorization: Bearer {{bobJwt}}
Content-Type: application/json
X-Correlation-Id: scenario5-publish-after-refollow

{
  "text": "Visible only after the new follow period begins"
}

### Verify the re-follow boundary in Alice's home timeline
GET {{gateway}}/api/v1/timeline/home?size=20
Authorization: Bearer {{aliceJwt}}
X-Correlation-Id: scenario5-home-after-refollow

### Timeline dependency failure (manual command)
# Run `docker compose stop post-service`, execute the request below, then run
# `docker compose start post-service` and repeat after Post is healthy.
GET {{gateway}}/api/v1/timeline/home?size=20
Authorization: Bearer {{aliceJwt}}
X-Correlation-Id: scenario7-post-dependency
